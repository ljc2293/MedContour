APP_PORT=18080
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=GENERATE_WITH_INIT_ENV
DATA_ROOT=./examples/demo/data
MANIFESTS_ROOT=./examples/demo/manifests
PANCREAS_PREDICTION_ROOT=./examples/demo/references
# Local HTTP only. Set true after configuring HTTPS.
COOKIE_SECURE=false
TRUSTED_ORIGINS=["http://127.0.0.1:18080","http://localhost:18080"]
# Optional Codex integration (compose.codex.yaml).
CODEX_MODEL=
CODEX_RUN_TIMEOUT_SECONDS=600
