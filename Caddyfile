:80 {
	encode zstd gzip

	request_body {
		max_size 1GB
	}

	@volumeFiles path_regexp volumeFiles ^/api/cases/[^/]+/((volume|display|preview)/(opp|in|f|w))\.nii\.gz$

	handle /api/* {
		handle @volumeFiles {
			reverse_proxy api:8000
		}

		handle {
			header Cache-Control "no-store"
			reverse_proxy api:8000
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
